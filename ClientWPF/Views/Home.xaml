<UserControl x:Class="ClientWPF.Views.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClientWPF.Views"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:ClientWPF.ViewModels"
             mc:Ignorable="d" 
             Style="{StaticResource DefaultPage}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <vm:HomeVM/>
    </UserControl.DataContext>
    <Grid Height="auto" Width="auto">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.15*"/>
            <RowDefinition/>
            <RowDefinition Height="0.15*"/>
        </Grid.RowDefinitions>

        <Grid>
            
        </Grid>

        <!-- Messeges View -->
        <ContentControl BorderThickness="0" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3">
            <vm:CurrentMessagesVM/>
        </ContentControl>


        <Grid Grid.Row="100" Grid.ColumnSpan="100">
            <Border CornerRadius="20" Background="{DynamicResource BackGround}"/>
            <Button Margin="10 7" Style="{StaticResource SendButton}" HorizontalAlignment="Right">
                <iconPacks:PackIconModern Margin="12 3 12 0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="20" Width="20" Kind="Message"/>
            </Button>
        </Grid>
        
    </Grid>
</UserControl>
