<UserControl x:Class="ClientWPF.Views.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClientWPF.Views"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:ClientWPF.ViewModels"
             mc:Ignorable="d" 
             Style="{StaticResource DefaultPage}"
             d:DesignHeight="500" d:DesignWidth="800">
    <d:UserControl.DataContext>
        <vm:HomeVM/>
    </d:UserControl.DataContext>
    <Grid Height="auto" Width="auto">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.11*"/>
            <RowDefinition/>
            <RowDefinition Height="0.12*"/>
        </Grid.RowDefinitions>

         <!-- Selected user -->
        <Grid DataContext="{Binding CurrentUser}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.4*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" CornerRadius="20" Background="{DynamicResource Pallete2}"/>
            <Grid Grid.ColumnSpan="1" HorizontalAlignment="Right">
                <Border Height="33" Width="33" CornerRadius="20" Background="{DynamicResource BackGround}" />
                <iconPacks:PackIconBootstrapIcons Kind="Person" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontSize="14" Style="{DynamicResource BiggerNormal}" Foreground="{StaticResource Pallete4}"/>
            </Grid>
        </Grid>

        <!-- Messeges View -->
        <ContentControl BorderThickness="0" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3">
            <vm:MessagesVM/>
        </ContentControl>


        <Grid Grid.Row="100" Grid.ColumnSpan="100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*"/>
                <ColumnDefinition Width="0.2*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="bord" Grid.ColumnSpan="2" CornerRadius="20" Background="{DynamicResource BackGround}"/>
            <Button Grid.Column="1" Margin="0 7 10 7" Style="{StaticResource SendButton}" HorizontalAlignment="Right" Command="{Binding SendCommand}">
                <iconPacks:PackIconModern Margin="12 3 12 0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="20" Width="20" Kind="Message"/>
            </Button>
            <TextBox Background="Transparent" VerticalContentAlignment="Center" BorderThickness="0" Padding="20 10" FontSize="13" Text="Test">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter"
                                Command="{Binding SendCommand}"/>
                </TextBox.InputBindings>

            </TextBox>
        </Grid>
        
    </Grid>
</UserControl>
