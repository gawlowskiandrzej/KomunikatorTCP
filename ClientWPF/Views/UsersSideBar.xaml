<UserControl x:Class="ClientWPF.Views.UsersSideBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClientWPF.Views"
             xmlns:vm="clr-namespace:ClientWPF.ViewModels"
             mc:Ignorable="d" 
             Style="{StaticResource DefaultPage}"
             d:DesignHeight="600" d:DesignWidth="300">
    <UserControl.DataContext>
        <vm:UsersSideBarVM/>
    </UserControl.DataContext>
    <Grid Width="auto">
        <ListView Width="auto" Height="auto" BorderThickness="0" Background="Transparent" ItemsSource="{Binding Users}" ItemContainerStyle="{StaticResource UserCard}" SelectedItem="{Binding SelectedUser}"/>
    </Grid>
</UserControl>
