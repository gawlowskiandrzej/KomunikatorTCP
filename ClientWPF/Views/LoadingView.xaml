<UserControl x:Class="ClientWPF.Views.LoadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:ClientWPF.Views"
             xmlns:vm="clr-namespace:ClientWPF.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Visibility="{Binding ViewVisibility}">
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.ColumnSpan="3">
            <Border Grid.ColumnSpan="2" Background="{StaticResource Pallete2}" CornerRadius="15 15 0 0"/>
        </Grid>
        <Grid Grid.ColumnSpan="3" Grid.Row="1" Grid.RowSpan="3">
            <Border Grid.ColumnSpan="2" Background="{StaticResource BackGround}" CornerRadius="0 0 15 15"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.2*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock VerticalAlignment="Bottom" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Trwa ładowanie wiadomości" FontSize="20"/>
            <!--<TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="...." Grid.Row="1" FontSize="40"/>-->
            <ProgressBar Background="{DynamicResource Pallete1}" Foreground="{DynamicResource Pallete2}" Grid.Row="1" Height="30" Width="300" Maximum="100" Value="{Binding AnimatedBarValue}"/>
        </Grid>
    </Grid>
</UserControl>
