<Window x:Class="ClientWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mod="clr-namespace:ClientWPF.Models"
        xmlns:local="clr-namespace:ClientWPF"
        xmlns:vm="clr-namespace:ClientWPF.ViewModels"
        mc:Ignorable="d"
        FontFamily="Fonts/#Rubik Medium"
        Title="ClientWPF" Height="600" Width="850"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        TextBlock.Foreground="Black"
        MouseDown="Window_MouseDown"
        Background="Transparent">
    <Window.DataContext>
        <vm:MainVM/>
    </Window.DataContext>
    <Grid>

        <Border Grid.ColumnSpan="2" Grid.RowSpan="2" Background="#EBF1F4" CornerRadius="15"/>
        
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.1*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.3*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock Margin="35 0 0 0"
                       VerticalAlignment="Center" 
                       Text="Halo-Halo"
                       FontWeight="Bold"
                       FontSize="18"
                       Foreground="{DynamicResource Pallete3}"/>

            <StackPanel Margin="20 25 20 10" Grid.Row="1">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource SidebarButt}"/>
                </StackPanel.Resources>
                <Button Content="Login" Command="{Binding LoginCommand}"/>
                <Button Content="Home" Command="{Binding HomeCommand}"/>
                <Button Content="Wiadomości"/>
                <Button Content="Grupy"/>
            </StackPanel>

            <Border Margin="30" Background="White" Grid.Column="1" Grid.Row="1" CornerRadius="15" BorderThickness="3" BorderBrush="#F0F0F0">
                <ContentControl 
                                Grid.Column="1" 
                                Grid.Row="1" 
                                Content="{Binding CurrentView}" />
            </Border>


            <Grid Margin="0 0 30 0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource NavbarOperativeButts}"/>
                </Grid.Resources>
                <Button Grid.Column="0" Content="_" FontSize="13" Command="{Binding MinimalizeCommand}"/>
                <mod:NavBarMaxButt Grid.Column="1" Content="🗖" FontSize="15" Style="{StaticResource NavbarOperativeButts}"/>
                <Button Content="X" Foreground="#CE0000" FontSize="15" Grid.Column="2" Command="{Binding ExitCommand}"/>
            </Grid>

            <Grid Grid.ColumnSpan="2" Panel.ZIndex="-1">
                <Border Grid.ColumnSpan="2" Background="{StaticResource Pallete2}" CornerRadius="15 15 0 0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
