<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Status" TargetType="Border">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                <Setter Property="Background" Value="#00AF00"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                <Setter Property="Background" Value="#EF0000"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="SelectedUserBorder" TargetType="Border">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource Pallete1}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="False">
                <Setter Property="Background" Value="{StaticResource Pallete5}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
</ResourceDictionary>