<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    >
    <Style TargetType="ListViewItem" x:Key="UserCard">
        <Setter Property="Width" Value="auto"/>
        <Setter Property="Height" Value="auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid Margin="0 0 0 14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="40" Height="40" Panel.ZIndex="1" Margin="15 10 0 10">
                            <Border CornerRadius="50" Background="LightGray"/>
                            <iconPacks:PackIconModern Width="20"
                                                      Opacity="0.7"
                              Height="20"
                              Kind="User" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <Border Grid.ColumnSpan="2" Background="{StaticResource Pallete5}" CornerRadius="20"/>
                        <Grid Grid.Column="1">
                            <TextBlock Style="{StaticResource BiggerNormal}" Foreground="{StaticResource Pallete3}" Text="{Binding Name}" />
                        </Grid>
                        
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        
    </Style>
</ResourceDictionary>